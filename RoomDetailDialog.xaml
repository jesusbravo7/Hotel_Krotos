<Window x:Class="LosKrotos.Desktop.RoomDetailDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LosKrotos.Desktop"
        Title="Detalle de habitación · Los Krotos" Width="650" Height="680" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="#081727" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#E0EFFB"/><Setter Property="Foreground" Value="#10253C"/><Setter Property="BorderBrush" Value="#7AAAD2"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#E0EFFB"/><Setter Property="Foreground" Value="#10253C"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#9CB7CE"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
    <Style x:Key="Action" TargetType="Button"><Setter Property="Background" Value="#367BC0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
    <DockPanel Margin="0,0,0,20"><Border DockPanel.Dock="Right" Background="#20476A" CornerRadius="11" Padding="12,7"><TextBlock x:Name="StatusText" Foreground="#DDEEFF" FontWeight="SemiBold"/></Border><StackPanel><TextBlock x:Name="RoomTitle" FontSize="30" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="TypeText" Foreground="#9CB7CE" FontSize="13" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Border CornerRadius="14" ClipToBounds="True" Height="210" Background="#14324D"><Image x:Name="HeroImage" Stretch="UniformToFill" local:RoundedImage.Radius="14"/></Border>
    <TextBlock Text="Fotografía ilustrativa creada para el prototipo" Foreground="#8FAFC9" FontSize="11" Margin="0,7,0,22"/>
    <UniformGrid Columns="2" Margin="0,0,0,20">
      <Border Background="#122B44" CornerRadius="12" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="PRECIO / NOCHE" Style="{StaticResource Label}"/><TextBlock x:Name="RateText" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Background="#122B44" CornerRadius="12" Padding="16" Margin="0,0,9,0"><StackPanel><TextBlock Text="CAPACIDAD" Style="{StaticResource Label}"/><TextBlock x:Name="CapacityText" Style="{StaticResource Value}"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="Descripción" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
    <TextBlock x:Name="DescriptionText" Foreground="#BBD0E3" TextWrapping="Wrap" Margin="0,7,0,22"/>
    <Border Height="1" Background="#2C4B68" Margin="0,0,0,20"/>
    <TextBlock Text="Estado operativo" FontSize="17" Foreground="White" FontWeight="SemiBold"/>
    <TextBlock x:Name="StatusHelpText" Text="La ocupación se gestiona desde check-in y check-out." Foreground="#9CB7CE" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <DockPanel LastChildFill="False"><ComboBox x:Name="StatusPicker" Width="210" Padding="8,6" Margin="0,0,10,0"><ComboBoxItem Content="Disponible" Tag="Available"/><ComboBoxItem Content="Por limpiar" Tag="Dirty"/><ComboBoxItem Content="Mantenimiento" Tag="Maintenance"/></ComboBox><Button x:Name="SaveStatusButton" Content="Guardar estado" Style="{StaticResource Action}" Click="SaveStatus_Click"/></DockPanel>
    <DockPanel LastChildFill="False" Margin="0,24,0,0"><Button Content="Editar datos de habitación" Style="{StaticResource Action}" Background="#20476A" Click="Edit_Click" Margin="0,0,10,0"/><Button Content="Cerrar" Style="{StaticResource Action}" Background="#20476A" Click="Close_Click"/></DockPanel>
  </StackPanel></ScrollViewer>
</Window>

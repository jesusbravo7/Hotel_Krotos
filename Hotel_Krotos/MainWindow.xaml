<Window x:Class="LosKrotos.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Los Krotos · Gestión hotelera" Width="1400" Height="870" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="#F3F7F3" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Forest" Color="#10563F"/>
    <SolidColorBrush x:Key="Ink" Color="#19352C"/>
    <SolidColorBrush x:Key="Muted" Color="#687F73"/>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="{StaticResource Forest}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#E5F2E8"/><Setter Property="Foreground" Value="{StaticResource Forest}"/></Style>
    <Style x:Key="Nav" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D3E6D9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="15,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="TileButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#CFDDD2"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#CFDDD2"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="40"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AlternatingRowBackground" Value="#F5F9F5"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102F26" Padding="16,23">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="⌂  LOS KROTOS" Foreground="White" FontSize="19" FontWeight="Bold" Margin="8,4,0,0"/>
          <TextBlock Text="HOTEL · ADMINISTRACIÓN" Foreground="#9FC8B0" FontSize="10" Margin="35,2,0,33"/>
          <TextBlock Text="ESPACIO DE TRABAJO" Foreground="#8CAE9C" FontSize="10" FontWeight="Bold" Margin="13,0,0,10"/>
          <Button Content="▦   Panel principal" Tag="0" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="▣   Reservas" Tag="1" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="⇄   Check-in / Check-out" Tag="6" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="▤   Habitaciones" Tag="2" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="♙   Huéspedes" Tag="3" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="✦   Limpieza" Tag="4" Click="Navigate_Click" Style="{StaticResource Nav}"/>
          <Button Content="▥   Reportes" Tag="5" Click="Navigate_Click" Style="{StaticResource Nav}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#1E4435" CornerRadius="10" Padding="12" VerticalAlignment="Bottom">
          <StackPanel><TextBlock Text="RECEPCIÓN" Foreground="#A8CBB3" FontSize="10" FontWeight="Bold"/><TextBlock Text="Sesión de demostración" Foreground="White" Margin="0,5,0,0"/><TextBlock Text="Datos locales" Foreground="#A8CBB3" FontSize="11"/></StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E1EAE2" BorderThickness="0,0,0,1" Padding="28,0">
        <Grid><TextBlock Text="Gestión del hotel" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="●  Operación activa     Administrador" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Forest}" FontSize="12"/></Grid>
      </Border>
      <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent">
        <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle>
        <TabItem Header="Panel">
          <ScrollViewer><StackPanel Margin="28,25,28,30">
            <TextBlock Text="Buenos días, equipo" Style="{StaticResource Title}"/><TextBlock Text="Esto está pasando hoy en Los Krotos." Style="{StaticResource Hint}" Margin="0,4,0,22"/>
            <UniformGrid Columns="4" Margin="0,0,0,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LLEGADAS HOY" Style="{StaticResource Hint}"/><TextBlock x:Name="TodayReservationsText" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="OCUPACIÓN" Style="{StaticResource Hint}"/><TextBlock x:Name="OccupancyText" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DISPONIBLES" Style="{StaticResource Hint}"/><TextBlock x:Name="AvailableText" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="POR LIMPIAR" Style="{StaticResource Hint}"/><TextBlock x:Name="DirtyText" FontSize="31" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,12,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,18,0"><StackPanel><TextBlock Text="Reservas de los próximos 14 días" Style="{StaticResource Section}"/><TextBlock Text="Estancias activas por día" Style="{StaticResource Hint}" Margin="0,4,0,13"/>
                <Border Background="#F5FAF6" CornerRadius="9" Padding="10"><Viewbox Stretch="Fill" Height="218"><Canvas Width="600" Height="200">
                  <Line X1="0" X2="600" Y1="170" Y2="170" Stroke="#DCE9DF"/><Line X1="0" X2="600" Y1="120" Y2="120" Stroke="#E6EFE8"/><Line X1="0" X2="600" Y1="70" Y2="70" Stroke="#E6EFE8"/><Line X1="0" X2="600" Y1="20" Y2="20" Stroke="#E6EFE8"/>
                  <Polygon x:Name="ReservationsArea" Fill="#CAEAD5" Opacity="0.55"/>
                  <Polyline x:Name="ReservationsLine" Stroke="#148156" StrokeThickness="4" StrokeLineJoin="Round"/>
                </Canvas></Viewbox></Border>
                <DockPanel Margin="0,8,0,0"><TextBlock Text="Hoy" Style="{StaticResource Hint}"/><TextBlock Text="+7 días" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><TextBlock Text="+14 días" Style="{StaticResource Hint}" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
              </StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Estado de habitaciones" Style="{StaticResource Section}"/><TextBlock Text="Distribución actual del inventario" Style="{StaticResource Hint}" Margin="0,4,0,15"/>
                <Grid Height="154"><Ellipse Width="132" Height="132" Stroke="#E2ECE4" StrokeThickness="17" HorizontalAlignment="Center"/><Path x:Name="OccupiedArc" Width="132" Height="132" Stretch="None" Stroke="#1B8862" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="DonutTotalText" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/><TextBlock Text="habitaciones" Style="{StaticResource Hint}" HorizontalAlignment="Center"/></StackPanel></Grid>
                <TextBlock x:Name="StatusSummaryText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,12,0,0"/>
              </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}"><DockPanel><TextBlock Text="Próximas llegadas" Style="{StaticResource Section}" DockPanel.Dock="Top" Margin="0,0,0,14"/><DataGrid ItemsSource="{Binding UpcomingReservations}" Height="190"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding RoomNumber}" Width="120"/><DataGridTextColumn Header="Entrada" Binding="{Binding CheckIn, StringFormat=dd/MM/yyyy}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="120"/></DataGrid.Columns></DataGrid></DockPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Reservas">
          <Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="Reservas" Style="{StaticResource Title}"/><TextBlock Text="Organiza las estancias y el registro de llegada." Style="{StaticResource Hint}"/></StackPanel><Button Content="＋  Nueva reserva" Style="{StaticResource Primary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="NewReservation_Click"/></DockPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,16,0"><DockPanel><TextBox x:Name="ReservationSearch" DockPanel.Dock="Top" Margin="0,0,0,14" ToolTip="Buscar por nombre, habitación o estado" TextChanged="ReservationSearch_TextChanged"/><DataGrid x:Name="ReservationsGrid" ItemsSource="{Binding FilteredReservations}" SelectionChanged="ReservationsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding RoomNumber}" Width="60"/><DataGridTextColumn Header="Entrada" Binding="{Binding CheckIn, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Salida" Binding="{Binding CheckOut, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Detalle de reserva" Style="{StaticResource Section}"/><TextBlock Text="Selecciona una estancia para gestionarla." Style="{StaticResource Hint}" Margin="0,5,0,20"/><TextBlock x:Name="SelectedReservationName" Text="Ninguna seleccionada" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="SelectedReservationInfo" Style="{StaticResource Hint}" Margin="0,8,0,20" TextWrapping="Wrap"/><Button Content="Registrar check-in" Style="{StaticResource Primary}" Click="CheckIn_Click" Margin="0,0,0,9"/><Button Content="Registrar check-out" Style="{StaticResource Secondary}" Click="CheckOut_Click" Margin="0,0,0,9"/><Button Content="Cancelar reserva" Style="{StaticResource Secondary}" Click="CancelReservation_Click"/><TextBlock Text="Confirmada → En casa → Finalizada. Al salir, la habitación pasa a limpieza." Style="{StaticResource Hint}" Margin="0,25,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0"><DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><StackPanel><TextBlock Text="Calendario de habitaciones" Style="{StaticResource Section}"/><TextBlock x:Name="ScheduleRangeText" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" Style="{StaticResource Secondary}" Click="PreviousWeek_Click" Margin="0,0,5,0"/><Button Content="Hoy" Style="{StaticResource Secondary}" Click="CurrentWeek_Click" Margin="0,0,5,0"/><Button Content="›" Style="{StaticResource Secondary}" Click="NextWeek_Click"/></StackPanel></DockPanel>
              <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Habitación" Style="{StaticResource Hint}" VerticalAlignment="Center"/><ItemsControl Grid.Column="1" ItemsSource="{Binding ScheduleDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Foreground="#687F73" HorizontalAlignment="Center" FontWeight="SemiBold"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ScheduleRows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" Foreground="#19352C" VerticalAlignment="Center"/><ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="5" Margin="2,0" Height="24"><TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              </DockPanel>
            </DockPanel></Border>
          </Grid>
        </TabItem>
        <TabItem Header="Habitaciones">
          <Grid Margin="28,24,28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18"><Button Content="＋  Añadir habitación" Style="{StaticResource Primary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="NewRoom_Click"/><StackPanel><TextBlock Text="Habitaciones" Style="{StaticResource Title}"/><TextBlock Text="Vista general del inventario y su estado actual." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></DockPanel>
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,18">
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="RoomTotalText" FontSize="27" FontWeight="Bold" Foreground="#19352C"/><TextBlock Text="Total" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="RoomAvailableText" FontSize="27" FontWeight="Bold" Foreground="#27B886"/><TextBlock Text="Disponibles" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="RoomOccupiedText" FontSize="27" FontWeight="Bold" Foreground="#6487D9"/><TextBlock Text="Ocupadas" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="RoomReservedText" FontSize="27" FontWeight="Bold" Foreground="#C9A533"/><TextBlock Text="Reservadas" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock x:Name="RoomMaintenanceText" FontSize="27" FontWeight="Bold" Foreground="#D76070"/><TextBlock Text="Mantenimiento" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="RoomDirtyText" FontSize="27" FontWeight="Bold" Foreground="#C9A533"/><TextBlock Text="Por limpiar" Style="{StaticResource Hint}"/></StackPanel></Border>
            </UniformGrid>
            <WrapPanel x:Name="RoomFilters" Grid.Row="2" Margin="0,0,0,16">
              <Button Content="Todos" Tag="All" Click="RoomFilter_Click" Style="{StaticResource Primary}" Margin="0,0,6,6"/>
              <Button Content="Disponibles" Tag="Available" Click="RoomFilter_Click" Style="{StaticResource Secondary}" Margin="0,0,6,6"/>
              <Button Content="Ocupadas" Tag="Occupied" Click="RoomFilter_Click" Style="{StaticResource Secondary}" Margin="0,0,6,6"/>
              <Button Content="Reservadas" Tag="Reserved" Click="RoomFilter_Click" Style="{StaticResource Secondary}" Margin="0,0,6,6"/>
              <Button Content="Por limpiar" Tag="Dirty" Click="RoomFilter_Click" Style="{StaticResource Secondary}" Margin="0,0,6,6"/>
              <Button Content="Mantenimiento" Tag="Maintenance" Click="RoomFilter_Click" Style="{StaticResource Secondary}" Margin="0,0,16,6"/>
              <ComboBox x:Name="FloorFilter" Width="118" SelectionChanged="RoomFilter_SelectionChanged" Margin="0,0,8,6"><ComboBoxItem Content="Todos los pisos" IsSelected="True"/></ComboBox>
              <ComboBox x:Name="TypeFilter" Width="140" SelectionChanged="RoomFilter_SelectionChanged" Margin="0,0,0,6"><ComboBoxItem Content="Todos los tipos" IsSelected="True"/></ComboBox>
            </WrapPanel>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border CornerRadius="15" Padding="10" Margin="0,0,10,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#174334" Offset="0"/><GradientStop Color="#0B2925" Offset="1"/></LinearGradientBrush></Border.Background>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FilteredRoomTiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource TileButton}" Click="RoomTile_Click" Tag="{Binding Room}" Margin="4">
                    <Border Width="135" Height="146" CornerRadius="11" Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="2" Padding="9">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Room.Number}" FontSize="27" FontWeight="Bold" Foreground="{Binding Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Room.Type}" FontSize="11" Foreground="#667B70" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding FloorLabel}" FontSize="10" Foreground="#87998D" HorizontalAlignment="Center" Margin="0,2,0,7"/>
                        <Border Background="{Binding Accent}" CornerRadius="9" Padding="8,3" HorizontalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" FontSize="9" FontWeight="Bold" Foreground="White"/></Border>
                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#87998D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                      </StackPanel>
                    </Border>
                  </Button></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl></ScrollViewer>
              </Border>
              <Border x:Name="RoomEditorPanel" Grid.Column="1" Width="290" Visibility="Collapsed" Style="{StaticResource Card}">
                <ScrollViewer><StackPanel><DockPanel Margin="0,0,0,15"><Button Content="✕" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Click="CloseRoomEditor_Click"/><TextBlock Text="Datos de habitación" Style="{StaticResource Section}" VerticalAlignment="Center"/></DockPanel>
                  <TextBlock Text="Número" Style="{StaticResource Hint}"/><TextBox x:Name="RoomNumberBox" IsReadOnly="True" Margin="0,4,0,10"/>
                  <TextBlock Text="Tipo" Style="{StaticResource Hint}"/><ComboBox x:Name="RoomTypeBox" Margin="0,4,0,10"><ComboBoxItem Content="Estándar"/><ComboBoxItem Content="Deluxe"/><ComboBoxItem Content="Suite"/><ComboBoxItem Content="Familiar"/></ComboBox>
                  <TextBlock Text="Capacidad" Style="{StaticResource Hint}"/><TextBox x:Name="RoomCapacityBox" Margin="0,4,0,10"/>
                  <TextBlock Text="Tarifa por noche (Q)" Style="{StaticResource Hint}"/><TextBox x:Name="RoomRateBox" Margin="0,4,0,10"/>
                  <TextBlock Text="Descripción" Style="{StaticResource Hint}"/><TextBox x:Name="RoomDescriptionBox" Height="63" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,13"/>
                  <Button Content="Guardar cambios" Style="{StaticResource Primary}" Click="SaveRoom_Click"/><Button Content="Eliminar habitación" Style="{StaticResource Secondary}" Click="DeleteRoom_Click" Margin="0,8,0,0"/>
                </StackPanel></ScrollViewer>
              </Border>
              <DataGrid x:Name="RoomsGrid" Visibility="Collapsed" ItemsSource="{Binding Rooms}" SelectionChanged="RoomsGrid_SelectionChanged"/>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Huéspedes">
          <Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Huéspedes" Style="{StaticResource Title}"/><TextBlock Text="Datos de contacto e historial de estancias." Style="{StaticResource Hint}"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,16,0"><DockPanel><TextBlock Text="Directorio" Style="{StaticResource Section}" DockPanel.Dock="Top" Margin="0,0,0,15"/><DataGrid x:Name="GuestsGrid" ItemsSource="{Binding Guests}" SelectionChanged="GuestsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="180"/></DataGrid.Columns></DataGrid></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer><StackPanel><TextBlock Text="Ficha del huésped" Style="{StaticResource Section}" Margin="0,0,0,17"/><TextBlock Text="Nombre completo" Style="{StaticResource Hint}"/><TextBox x:Name="GuestNameBox" Margin="0,4,0,11"/><TextBlock Text="Teléfono" Style="{StaticResource Hint}"/><TextBox x:Name="GuestPhoneBox" Margin="0,4,0,11"/><TextBlock Text="Correo electrónico" Style="{StaticResource Hint}"/><TextBox x:Name="GuestEmailBox" Margin="0,4,0,11"/><TextBlock Text="Documento" Style="{StaticResource Hint}"/><TextBox x:Name="GuestDocumentBox" Margin="0,4,0,15"/><Button Content="Guardar huésped" Style="{StaticResource Primary}" Click="SaveGuest_Click"/><Button Content="Nuevo huésped" Style="{StaticResource Secondary}" Margin="0,8,0,0" Click="NewGuest_Click"/><TextBlock Text="Historial de reservas" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,22,0,7"/><TextBlock x:Name="GuestHistoryText" Style="{StaticResource Hint}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Limpieza">
          <Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Limpieza y mantenimiento" Style="{StaticResource Title}"/><TextBlock Text="Prepara habitaciones para la próxima llegada." Style="{StaticResource Hint}"/></StackPanel>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,16,0"><DockPanel><TextBlock Text="Estado de habitaciones" Style="{StaticResource Section}" DockPanel.Dock="Top" Margin="0,0,0,15"/><DataGrid x:Name="CleaningGrid" ItemsSource="{Binding Rooms}" SelectionChanged="CleaningGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Habitación" Binding="{Binding Number}" Width="120"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="150"/></DataGrid.Columns></DataGrid></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cambiar estado" Style="{StaticResource Section}"/><TextBlock x:Name="CleaningRoomText" Text="Ninguna seleccionada" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,20,0,18"/><Button Content="Marcar como limpia" Style="{StaticResource Primary}" Click="MarkClean_Click" Margin="0,0,0,9"/><Button Content="Enviar a limpieza" Style="{StaticResource Secondary}" Click="MarkDirty_Click" Margin="0,0,0,9"/><Button Content="Marcar mantenimiento" Style="{StaticResource Secondary}" Click="MarkMaintenance_Click"/><TextBlock Text="Las habitaciones ocupadas no se pueden cambiar desde aquí." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,22,0,0"/></StackPanel></Border></Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Reportes">
          <ScrollViewer><StackPanel Margin="28,25,28,30"><TextBlock Text="Reportes" Style="{StaticResource Title}"/><TextBlock Text="Resumen operativo sin datos de pagos." Style="{StaticResource Hint}" Margin="0,4,0,22"/>
            <UniformGrid Columns="4" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="RESERVAS TOTALES" Style="{StaticResource Hint}"/><TextBlock x:Name="ReportTotalText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CONFIRMADAS" Style="{StaticResource Hint}"/><TextBlock x:Name="ReportConfirmedText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="EN CASA" Style="{StaticResource Hint}"/><TextBlock x:Name="ReportActiveText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FINALIZADAS" Style="{StaticResource Hint}"/><TextBlock x:Name="ReportCompletedText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Forest}" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
            <Border Style="{StaticResource Card}"><DockPanel><TextBlock Text="Próximas salidas" Style="{StaticResource Section}" DockPanel.Dock="Top" Margin="0,0,0,15"/><DataGrid ItemsSource="{Binding UpcomingDepartures}" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Habitación" Binding="{Binding RoomNumber}" Width="140"/><DataGridTextColumn Header="Salida" Binding="{Binding CheckOut, StringFormat=dd/MM/yyyy}" Width="140"/><DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="140"/></DataGrid.Columns></DataGrid></DockPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Recepción">
          <Grid Margin="28,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="Check-in / Check-out" Style="{StaticResource Title}"/><TextBlock Text="Gestiona llegadas y salidas desde el mostrador." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LLEGADAS PENDIENTES" Style="{StaticResource Hint}"/><TextBlock x:Name="DeskArrivalsText" FontSize="29" Foreground="{StaticResource Forest}" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="HUÉSPEDES EN CASA" Style="{StaticResource Hint}"/><TextBlock x:Name="DeskInHouseText" FontSize="29" Foreground="{StaticResource Forest}" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SALIDAS HOY" Style="{StaticResource Hint}"/><TextBlock x:Name="DeskDeparturesText" FontSize="29" Foreground="{StaticResource Forest}" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,9,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Llegadas" Style="{StaticResource Section}"/><TextBlock Text="Reservas confirmadas hasta los próximos siete días" Style="{StaticResource Hint}" Margin="0,4,0,13"/></StackPanel><Button Content="Registrar check-in" Style="{StaticResource Primary}" DockPanel.Dock="Bottom" Margin="0,13,0,0" Click="FrontDeskCheckIn_Click"/><DataGrid x:Name="ArrivalDeskGrid" ItemsSource="{Binding DeskArrivalReservations}"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding RoomNumber}" Width="65"/><DataGridTextColumn Header="Entrada" Binding="{Binding CheckIn, StringFormat=dd/MM/yyyy}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="En casa" Style="{StaticResource Section}"/><TextBlock Text="Estancias activas listas para registrar salida" Style="{StaticResource Hint}" Margin="0,4,0,13"/></StackPanel><Button Content="Registrar check-out" Style="{StaticResource Primary}" DockPanel.Dock="Bottom" Margin="0,13,0,0" Click="FrontDeskCheckOut_Click"/><DataGrid x:Name="InHouseGrid" ItemsSource="{Binding InHouseReservations}"><DataGrid.Columns><DataGridTextColumn Header="Huésped" Binding="{Binding GuestName}" Width="*"/><DataGridTextColumn Header="Hab." Binding="{Binding RoomNumber}" Width="65"/><DataGridTextColumn Header="Salida" Binding="{Binding CheckOut, StringFormat=dd/MM/yyyy}" Width="100"/></DataGrid.Columns></DataGrid></DockPanel></Border>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>

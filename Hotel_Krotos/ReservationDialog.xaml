<Window x:Class="LosKrotos.Desktop.ReservationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva reserva · Los Krotos" Width="520" Height="650" MinWidth="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F7F3" FontFamily="Segoe UI">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="Nueva reserva" Foreground="#19352C" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Completa los datos de la estancia." Foreground="#687F73" FontSize="13" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Huésped registrado" Foreground="#687F73" FontSize="12"/><ComboBox x:Name="GuestPicker" Margin="0,5,0,7" DisplayMemberPath="FullName" Padding="8,6"/>
        <TextBlock Text="O escribe un nombre nuevo" Foreground="#687F73" FontSize="12"/><TextBox x:Name="NewGuestName" Margin="0,5,0,16" Padding="9,7"/>
        <TextBlock Text="Habitación" Foreground="#687F73" FontSize="12"/><ComboBox x:Name="RoomPicker" Margin="0,5,0,16" Padding="8,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Entrada" Foreground="#687F73" FontSize="12"/><DatePicker x:Name="StartPicker" Margin="0,5,0,16"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Salida" Foreground="#687F73" FontSize="12"/><DatePicker x:Name="EndPicker" Margin="0,5,0,16"/></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Adultos" Foreground="#687F73" FontSize="12"/><TextBox x:Name="AdultsBox" Text="2" Padding="9,7" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Niños" Foreground="#687F73" FontSize="12"/><TextBox x:Name="ChildrenBox" Text="0" Padding="9,7" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <TextBlock Text="Las fechas ocupadas y habitaciones en mantenimiento se validan al guardar." Foreground="#687F73" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancelar" Click="Cancel_Click" Background="#E5F2E8" Foreground="#10563F" BorderThickness="0" Padding="18,10" Margin="0,0,8,0"/><Button Content="Crear reserva" Click="Create_Click" Background="#10563F" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Padding="18,10"/></StackPanel>
  </Grid>
</Window>
